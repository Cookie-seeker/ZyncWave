<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ZyncWave2" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#191c1f</item>
        <item name="colorPrimaryVariant">#1a1a2e</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>

    <style name="Theme.ZyncWave2.SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/intro_pic</item>
        <item name="postSplashScreenTheme">@style/Theme.ZyncWave2</item>
    </style>

    <style name="TabTextAppearance" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>